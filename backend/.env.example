# SentiGuard Backend Environment Configuration
# Copy this to .env for local development or set in Render Environment Variables

# Server Port (Render sets this automatically via $PORT)
PORT=8000

# Environment mode: development | production
ENVIRONMENT=production

# CORS allowed origins (comma-separated or wildcard '*')
ALLOWED_ORIGINS=*

# Model file path (relative to backend root)
MODEL_PATH=models/phishing_model.pkl

# ── Phase 2: Caching & Threat Feeds ───────────────────────────
# In-memory TTL cache settings
CACHE_TTL_SECONDS=3600
CACHE_MAXSIZE=5000

# Optional Redis Cache (falls back automatically to in-memory TTLCache if empty)
# REDIS_URL=redis://localhost:6379/0

# Database URL for scan telemetry and dispute logs (default: SQLite)
DATABASE_URL=sqlite:///./sentiguard.db

# API rate limiting threshold per client IP
RATE_LIMIT_PER_MINUTE=60/minute

# External Threat Feeds (Optional)
# Google Safe Browsing API v4 Key (https://console.cloud.google.com/apis/credentials)
# GOOGLE_SAFE_BROWSING_KEY=your_google_api_key_here

# Cloudflare Radar API Bearer Token
# CLOUDFLARE_RADAR_TOKEN=your_cloudflare_radar_token_here
