{
  "buildCommand": "echo 'Static site - no build needed'",
  "installCommand": "echo 'No dependencies'",
  "framework": "static",
  "outputDirectory": "website",
  "rootDirectory": ".",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://sentiguard-hkef.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sentiguard-hkef.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://sentiguard-hkef.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://sentiguard-hkef.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://sentiguard-hkef.onrender.com/openapi.json"
    }
  ],
  "devCommand": "python -m http.server 8000 --directory website",
  "devPath": "website"
}
