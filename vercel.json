{
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://sentiguard-api.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sentiguard-api.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://sentiguard-api.onrender.com/docs"
    },
    {
      "source": "/redoc",
      "destination": "https://sentiguard-api.onrender.com/redoc"
    },
    {
      "source": "/openapi.json",
      "destination": "https://sentiguard-api.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
